@model IEnumerable<SistemaConsultas.Models.Consulta>

<h2>Minhas Consultas</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Agendar Nova Consulta</a>

<table class="table">
    <thead>
        <tr>
            <th>Especialidade</th>
            <th>Data e Hora</th>
            <th>Descrição</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Especialidade</td>
            <td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@item.Descricao</td>
            <td>
                <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>